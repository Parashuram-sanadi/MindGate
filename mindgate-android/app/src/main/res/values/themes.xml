<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MindGate" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Theme.MindGate.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mindgate_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MindGate</item>
    </style>
    <style name="Theme.MindGate.Overlay" parent="Theme.MindGate">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
